{
  "name": "@junctura/ui",
  "version": "0.1.0-rc",
  "description": "Gói giao diện React dùng chung của Junctura Workspace: 21 thành phần, token, kiểu và phông, không mang giá trị mặc định của một ngành cụ thể.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/vku2-open-source-2026/junctura-workspace/tree/main/packages/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vku2-open-source-2026/junctura-workspace.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/vku2-open-source-2026/junctura-workspace/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "lucide-react": "^1.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
