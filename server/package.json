{
  "name": "junctura-workspace-portal-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend của Cổng Junctura Workspace: phục vụ phép chiếu công khai của gói đã cài, lưu bảng tin, ghi chú và tệp đính kèm của hồ sơ liên thông qua Tầng 1 (Junctura DX-OS).",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/vku2-open-source-2026/junctura-workspace/tree/main/server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vku2-open-source-2026/junctura-workspace.git",
    "directory": "server"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node main.mjs",
    "test": "node --test",
    "pack:install": "node ../scripts/pack-install.mjs",
    "pack:list": "node ../scripts/pack-install.mjs --list",
    "pack:select": "node ../scripts/pack-install.mjs --select",
    "pack:retire": "node ../scripts/pack-install.mjs --retire"
  },
  "dependencies": {
    "@junctura/server-client": "^0.1.0",
    "ajv": "8.20.0",
    "saxes": "6.0.0"
  }
